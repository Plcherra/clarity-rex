# Rex API production environment for /opt/clarity/shared/rex-api.env

APP_ENVIRONMENT=production
APP_TIMEZONE=America/New_York
# Optional crash reporting. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
CORS_ALLOWED_ORIGINS=

GROK_API_KEY=
GROK_MODEL=grok-4.3
GROK_FAST_MODEL=
GROK_STANDARD_MODEL=
GROK_REASONING_MODEL=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Required in production (usage tracking + Plaid persistence).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_LONG_TERM_MEMORY_TABLE=long_term_memory
SUPABASE_MEMORY_CORRECTIONS_TABLE=memory_corrections
SUPABASE_VOICE_TURNS_TABLE=voice_turns

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
PLAID_WEB_REDIRECT_URI=https://goclarity.app/app/
PLAID_WEBHOOK_URL=
# Required for production boot when Plaid credentials are present.
# Generate a dedicated secret (do NOT reuse PLAID_SECRET), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PLAID_TOKEN_ENCRYPTION_SECRET=
# Optional Plaid add-on. Leave false unless Plaid approves transactions_refresh.
PLAID_ENABLE_TRANSACTIONS_REFRESH=false
# SUPABASE_SERVICE_ROLE_KEY must also be set when Plaid is enabled.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_TIMEOUT_SECONDS=60
DEEPGRAM_ENDPOINTING_MS=1600
DEEPGRAM_LIVE_TRANSCRIPT_IDLE_MS=1800

GOOGLE_TTS_PROJECT_ID=
# Use GOOGLE_APPLICATION_CREDENTIALS for a service-account file path on the VPS,
# for example /opt/clarity/secrets/service_account.json.
# GOOGLE_TTS_CREDENTIALS_JSON may contain raw service-account JSON.
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_BASE_URL=https://texttospeech.googleapis.com/v1
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-J
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=1.15
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_VOLUME_GAIN_DB=10.0
GOOGLE_TTS_TIMEOUT_SECONDS=60
