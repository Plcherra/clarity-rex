[Unit]
Description=Clarity Rex API
After=network-online.target
Wants=network-online.target

[Service]
User=rex
Group=rex
WorkingDirectory=/opt/clarity/current/services/rex-api
EnvironmentFile=/opt/clarity/shared/rex-api.env
ExecStart=/opt/clarity/current/services/rex-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
