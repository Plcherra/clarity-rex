# --- Model provider (pick ONE via MODEL) --------------------------------------
# The provider is auto-detected from the MODEL string and the matching API key
# below is used automatically.

# xAI Grok — get a key at https://console.x.ai -> API keys
XAI_API_KEY=xai-your-key-here

# OpenAI GPT — get a key at https://platform.openai.com/api-keys
# GPT is the most reliable choice inside CrewAI's tool loop. If Grok keeps
# returning empty responses, set MODEL=gpt-4o-mini and fill this in.
# OPENAI_API_KEY=sk-your-key-here

# Choose the model. Provider is inferred from the prefix.
#   MODEL=xai/grok-3-mini   (cheap + fast; a reasoning model — can return empties)
#   MODEL=xai/grok-3        (non-reasoning Grok; steadier)
#   MODEL=xai/grok-4
#   MODEL=gpt-4o-mini       (cheap + fast + very reliable with CrewAI tools)
#   MODEL=gpt-4o
MODEL=xai/grok-3

# Optional: give ONLY the Fix Applier a stronger model for precise edits.
# The applier must produce exact indentation for edit_file; weak models (e.g.
# gpt-4o-mini) often submit broken edits. Leave empty to reuse MODEL.
#   APPLIER_MODEL=gpt-4o
APPLIER_MODEL=

# --- LLM resilience / rate-limit tuning --------------------------------------
# Lower temperature = steadier output. Cap tokens to avoid rate limits.
TEMPERATURE=0.1
MAX_TOKENS=4000
# For the "mini" reasoning model only: low|high (low avoids empty content).
REASONING_EFFORT=low
# Retry when Grok returns None/empty output, with a linear backoff (seconds).
# Retries escalate temperature (0.5, 0.9) to break out of a stuck empty response.
LLM_EMPTY_RETRIES=3
LLM_RETRY_DELAY=3
# litellm-level retries for API errors (429/5xx).
LLM_API_RETRIES=3
# Last-resort model used only if the primary keeps returning empty content.
# If left unset: uses gpt-4o-mini when OPENAI_API_KEY is present, else xai/grok-3.
# Set to "none" to disable the fallback.
# FALLBACK_MODEL=gpt-4o-mini

# --- Auto-fix loop caps -------------------------------------------------------
# The crew always scans, finds, and applies fixes, looping until a pass makes no
# more edits or it hits these caps.
# MAX_FIXES=40      # stop after this many successful edits
# MAX_ROUNDS=6      # stop after this many full passes

# --- Optional: scope override -------------------------------------------------
# By default the repo root is auto-detected (parent of this crew/ folder).
# CLARITY_REPO_ROOT=C:\path\to\clarity-rex
