# --- Model provider: xAI Grok -------------------------------------------------
# Get a key at https://console.x.ai  -> API keys
XAI_API_KEY=xai-your-key-here

# Cheapest/fastest default. Override to another Grok model if you want:
#   MODEL=xai/grok-3-mini   (cheap + fast, default; a reasoning model)
#   MODEL=xai/grok-3        (non-reasoning; use this if you keep getting empty replies)
#   MODEL=xai/grok-4
MODEL=xai/grok-3-mini

# --- LLM resilience / rate-limit tuning --------------------------------------
# Lower temperature = steadier output. Cap tokens to avoid rate limits.
TEMPERATURE=0.1
MAX_TOKENS=4000
# For the "mini" reasoning model only: low|high (low avoids empty content).
REASONING_EFFORT=low
# Retry when Grok returns None/empty output, with a linear backoff (seconds).
# Retries escalate temperature (0.5, 0.9) to break out of a stuck empty response.
LLM_EMPTY_RETRIES=3
LLM_RETRY_DELAY=3
# litellm-level retries for API errors (429/5xx).
LLM_API_RETRIES=3
# Last-resort non-reasoning model used only if the mini model keeps returning
# empty content. Set to "none" to disable the fallback.
FALLBACK_MODEL=xai/grok-3

# --- Aggressive auto-fix mode -------------------------------------------------
# When true, the crew scans the whole repo, applies every fix it can, retries or
# reverts on test failure, and loops until no more edits or the caps below.
# (Same as passing --aggressive on the command line.)
# AGGRESSIVE_FIX=true
# MAX_FIXES=40      # stop after this many successful edits
# MAX_ROUNDS=6      # stop after this many full passes

# --- Optional: scope override -------------------------------------------------
# By default the repo root is auto-detected (parent of this crew/ folder).
# CLARITY_REPO_ROOT=C:\path\to\clarity-rex
