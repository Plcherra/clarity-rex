# Grok API settings. Required for real chat.
APP_ENVIRONMENT=development
# Include Flutter web dev (default port 8080) and production PWA origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,https://goclarity.app,https://app.goclarity.app
GROK_API_KEY=
GROK_MODEL=
GROK_FAST_MODEL=
GROK_STANDARD_MODEL=
GROK_REASONING_MODEL=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

# Supabase settings. URL and anon key are required for authenticated user-scoped requests.
# Service role is optional and should only be used for tightly scoped server maintenance.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_LONG_TERM_MEMORY_TABLE=long_term_memory
SUPABASE_MEMORY_CORRECTIONS_TABLE=memory_corrections
SUPABASE_VOICE_TURNS_TABLE=voice_turns

# Usage owner + billing estimates (Profile → Usage administration).
# Owner: set UUID OR rely on admin_users row (see migration 20260626000200_seed_usage_owner.sql).
USAGE_OWNER_USER_ID=c89fa61a-f67e-4454-a4a7-2775adc774c3
# Grok 4.x official rates ($1.25 in / $2.50 out per 1M tokens).
USAGE_GROK_INPUT_CENTS_PER_1K_TOKENS=0.125
USAGE_GROK_OUTPUT_CENTS_PER_1K_TOKENS=0.25
# Fallback when only total_tokens is available (no in/out split from Grok).
USAGE_GROK_CENTS_PER_1K_TOKENS=0.19
# Deepgram Nova streaming STT (~$0.20/hr ≈ 0.33¢/min). Separate from Grok LLM billing.
USAGE_DEEPGRAM_CENTS_PER_MINUTE=0.33
# Google Neural2 TTS ($16/1M chars).
USAGE_TTS_CENTS_PER_1K_CHARS=1.6
# Fallback TTS estimate when character count is missing.
USAGE_TTS_CENTS_PER_MINUTE=1.2

# Plaid settings. Backend only; mobile must never receive secret or access tokens.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=
PLAID_IOS_BUNDLE_ID=app.goclarity.clarity
PLAID_ANDROID_PACKAGE_NAME=com.clarity.clarity
PLAID_ACCOUNT_FILTERS_JSON=
PLAID_TIMEOUT_SECONDS=30
PLAID_TOKEN_ENCRYPTION_SECRET=
# Optional Plaid add-on. Leave false unless Plaid approves transactions_refresh.
PLAID_ENABLE_TRANSACTIONS_REFRESH=false

# Cloud voice settings. Required for Deepgram STT + Google TTS.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_TIMEOUT_SECONDS=60
DEEPGRAM_ENDPOINTING_MS=900
DEEPGRAM_LIVE_TRANSCRIPT_IDLE_MS=1100

GOOGLE_TTS_PROJECT_ID=
# Raw service-account JSON, or leave empty and set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account file path.
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_BASE_URL=https://texttospeech.googleapis.com/v1
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-J
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=1.18
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_VOLUME_GAIN_DB=10.0
GOOGLE_TTS_TIMEOUT_SECONDS=60
