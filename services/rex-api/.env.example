# Grok API settings. Required for real chat.
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GROK_API_KEY=
GROK_MODEL=
GROK_FAST_MODEL=
GROK_STANDARD_MODEL=
GROK_REASONING_MODEL=
REX_BRAIN_ROUTING_ENABLED=false
REX_BRAIN_DEBUG_ENABLED=false
REX_BRAIN_FAST_FIRST_ENABLED=false
# Rollout stages: disabled, logging_only, fast_contextual, analytical,
# launch_safe, strategic_reflective, deep_think_ui.
# Aliases: mvp, launch, production, prod -> launch_safe.
REX_BRAIN_ROLLOUT_STAGE=disabled
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

# Supabase settings. URL and anon key are required for authenticated user-scoped requests.
# Service role is optional and should only be used for tightly scoped server maintenance.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_LONG_TERM_MEMORY_TABLE=long_term_memory
SUPABASE_MEMORY_CORRECTIONS_TABLE=memory_corrections
SUPABASE_MEMORY_CANDIDATES_TABLE=memory_candidates
SUPABASE_VOICE_TURNS_TABLE=voice_turns

# Cloud voice settings. Required for Deepgram STT + Google TTS.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_TIMEOUT_SECONDS=60
DEEPGRAM_ENDPOINTING_MS=900
DEEPGRAM_LIVE_TRANSCRIPT_IDLE_MS=1100

GOOGLE_TTS_PROJECT_ID=
# Raw service-account JSON, or leave empty and set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account file path.
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_BASE_URL=https://texttospeech.googleapis.com/v1
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-J
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=1.14
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_VOLUME_GAIN_DB=10.0
GOOGLE_TTS_TIMEOUT_SECONDS=60
