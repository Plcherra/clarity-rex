---
import BaseLayout from '@layouts/BaseLayout.astro';
import DownloadActions from '../components/DownloadActions.astro';
import {
  downloadLinks,
  faqs,
  howItWorksSteps,
  product,
  publicRoutes,
  subscriptionValue,
} from '@content/site';

const page = publicRoutes.find((route) => route.path === '/')!;

const heroTrustLine = [
  'Plaid-authorized connections',
  'No bank passwords on Clarity',
  'Your data, your controls',
] as const;

const productScreens = [
  {
    label: 'Dashboard',
    title: 'See the month at a glance.',
    body: 'Balances, cash flow, and spending by category — one dark UI built for daily review.',
    image: '/images/app/dashboard-cash-flow.webp',
    alt: 'Clarity dashboard with total balance, monthly cash flow chart, and spending by category.',
  },
  {
    label: 'Rex chat',
    title: 'Ask when you need context.',
    body: 'Rex is the assistant inside Clarity — chat about money, goals, and life from real data.',
    image: '/images/app/rex-chat.webp',
    alt: 'Clarity Rex assistant chat screen with starter prompts and message composer.',
  },
  {
    label: 'Knows',
    title: 'What Clarity remembers — clearly labeled.',
    body: 'People, events, goals, and preferences stay organized. Saved memory is not chat history.',
    image: '/images/app/knows.webp',
    alt: 'Clarity Knows screen showing people, facts, and events Clarity remembers.',
  },
  {
    label: 'Budgets',
    title: 'Budget from real categories.',
    body: 'Set targets, watch what is left, and compare budget pressure against actual spending.',
    image: '/images/app/budgets.webp',
    alt: 'Clarity budgets screen showing monthly category targets and spending totals.',
  },
  {
    label: 'Transactions',
    title: 'Know what changed.',
    body: 'Filter by month, category, and account. Keep transaction history scannable.',
    image: '/images/app/transactions.webp',
    alt: 'Clarity transactions screen with month, category, account, and history filters.',
  },
  {
    label: 'Voice',
    title: 'Talk to Rex hands-free.',
    body: 'Voice uses the same Rex Brain as chat — same memory rules, same financial truth.',
    image: '/images/app/voice.webp',
    alt: 'Clarity voice usage screen showing Rex voice activity and daily call charts.',
  },
] as const;

const showAppStoreNote = !downloadLinks.appStore;
---

<BaseLayout title={page.title} description={page.description}>
  <section class="landing-hero">
    <div class="landing-hero__copy">
      <p class="eyebrow">Clarity · iPhone · Android · Web</p>
      <h1>{product.tagline}</h1>
      <p class="landing-hero__lede">
        Clarity combines your accounts, budgets, goals, and what it remembers with Rex — the
        assistant that explains your financial picture without moving money or guessing.
      </p>
      <DownloadActions layout="hero" showGhostLink />
      {
        showAppStoreNote ? (
          <p class="landing-hero__store-note">iPhone app coming to the App Store soon.</p>
        ) : null
      }
      <p class="hero-trust-line" aria-label="Trust highlights">
        {heroTrustLine.join(' · ')}
      </p>
    </div>

    <div class="hero-device-stack" aria-label="Clarity app screenshots">
      <div class="device-card device-card--secondary device-card--left">
        <img
          src="/images/app/rex-chat.webp"
          alt="Clarity Rex assistant chat screen."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="device-card device-card--primary">
        <img
          src="/images/app/dashboard-cash-flow.webp"
          alt="Clarity dashboard showing balances, cash flow, and spending by category."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="device-card device-card--secondary device-card--right">
        <img
          src="/images/app/knows.webp"
          alt="Clarity Knows screen showing saved people, facts, and events."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hero-proof-card hero-proof-card--top">
        <span>Dark UI</span>
        <strong>Built for daily review — mobile and web</strong>
      </div>
      <div class="hero-proof-card hero-proof-card--bottom">
        <span>Rex context</span>
        <strong>Answers from your approved data</strong>
      </div>
    </div>
  </section>

  <section class="section value-section" id="pricing" aria-labelledby="value-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">Why Clarity</p>
      <h2 id="value-heading">{subscriptionValue.headline}</h2>
      <p>{subscriptionValue.subhead}</p>
    </div>
    <div class="value-columns">
      {
        subscriptionValue.columns.map((column) => (
          <article class="value-column">
            <h3>{column.title}</h3>
            <p>{column.body}</p>
          </article>
        ))
      }
    </div>
    <div class="pricing-block">
      <p class="pricing-block__note">{subscriptionValue.pricingNote}</p>
      <a class="button button--primary" href={downloadLinks.webLogin}>Start on web</a>
    </div>
  </section>

  <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">How it works</p>
      <h2 id="how-heading">Clarity is here. Start on web today.</h2>
      <p>Create your account in minutes — same Clarity on laptop, phone, and browser.</p>
    </div>
    <ol class="how-steps">
      {
        howItWorksSteps.map((step, index) => (
          <li class="how-step">
            <span class="how-step__number">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section product-section" aria-labelledby="product-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">The app</p>
      <h2 id="product-heading">Finance, memory, and Rex — one workspace.</h2>
      <p>Real app screens with sample data. Dark, calm, and built for daily use.</p>
    </div>
    <div class="product-grid">
      {
        productScreens.map((screen) => (
          <article class="product-card">
            <figure>
              <img
                src={screen.image}
                alt={screen.alt}
                width="720"
                height="1415"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div>
              <span>{screen.label}</span>
              <h3>{screen.title}</h3>
              <p>{screen.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section web-section" aria-labelledby="web-heading">
    <div class="web-section__inner">
      <div>
        <p class="eyebrow">Web &amp; mobile</p>
        <h2 id="web-heading">Use Clarity in the browser today.</h2>
        <p>
          Same account when you install on iPhone or Android. One login, one Rex Brain, one source
          of truth for your money and memory.
        </p>
        {
          showAppStoreNote ? (
            <p class="web-section__note">App Store link added when approved.</p>
          ) : null
        }
      </div>
      <DownloadActions layout="compact" />
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-heading">
    <div class="section__header">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-heading">Common questions</h2>
      <p>
        Clear answers about accounts, Plaid, Rex, and your data. For security details, see our{' '}
        <a href="/security">Security</a> page.
      </p>
    </div>
    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section final-cta" aria-labelledby="final-cta-heading">
    <div class="final-cta__inner">
      <h2 id="final-cta-heading">Open Clarity on web — your account works on every device.</h2>
      <DownloadActions layout="footer" />
      <p class="final-cta__note">
        Questions? <a href="/contact">Contact support</a> · <a href="/privacy">Privacy</a>
      </p>
    </div>
  </section>
</BaseLayout>
