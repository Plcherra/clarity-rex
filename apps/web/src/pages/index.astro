---
import BaseLayout from '@layouts/BaseLayout.astro';
import DownloadActions from '../components/DownloadActions.astro';
import {
  authLinks,
  faqs,
  howItWorksSteps,
  product,
  publicRoutes,
  subscriptionValue,
} from '@content/site';

const page = publicRoutes.find((route) => route.path === '/')!;

const heroTrustLine = [
  'Plaid-authorized connections',
  'No bank passwords stored on Clarity',
  'Your data, your controls',
] as const;

const productScreens = [
  {
    label: 'Dashboard',
    title: 'See the month at a glance.',
    body: 'Balances, cash flow, and spending by category — on phone and in the web companion.',
    image: '/images/app/dashboard-cash-flow.webp',
    alt: 'Clarity dashboard with total balance, monthly cash flow chart, and spending by category.',
  },
  {
    label: 'Rex chat',
    title: 'Ask when you need context.',
    body: 'Rex answers from your connected data — not generic advice.',
    image: '/images/app/rex-chat.webp',
    alt: 'Clarity Rex assistant chat screen with starter prompts and message composer.',
  },
  {
    label: 'Knows',
    title: 'Saved memory, clearly labeled.',
    body: 'Facts, people, events, and preferences — separate from Goals and from chat history.',
    image: '/images/app/knows.webp',
    alt: 'Clarity Knows screen showing people, facts, and events Clarity remembers — not goals.',
  },
  {
    label: 'Goals',
    title: 'Goals and open threads.',
    body: 'Achievement-oriented plans and light habit check-ins live here — not inside Knows.',
    image: '/images/app/goals.webp',
    alt: 'Clarity Goals screen showing plans and open threads for accountability.',
  },
  {
    label: 'Budgets',
    title: 'Budget from real categories.',
    body: 'Set targets and compare spending against what you actually connect.',
    image: '/images/app/budgets.webp',
    alt: 'Clarity budgets screen showing monthly category targets and spending totals.',
  },
  {
    label: 'Accounts',
    title: 'Every account in one view.',
    body: 'Connect through Plaid when you choose. Disconnect anytime.',
    image: '/images/app/accounts.webp',
    alt: 'Clarity accounts screen showing connected bank accounts and balances.',
  },
  {
    label: 'Voice',
    title: 'Talk to Rex on the go.',
    body: 'Same Rex brain as chat. Best on iPhone and Android; browser voice works while this tab stays open.',
    image: '/images/app/voice.webp',
    alt: 'Clarity voice usage screen showing Rex voice activity and daily call charts.',
  },
] as const;
---

<BaseLayout title={page.title} description={page.description}>
  <section class="landing-hero">
    <div class="landing-hero__copy">
      <p class="eyebrow">Clarity</p>
      <h1>{product.tagline}</h1>
      <p class="landing-hero__lede">{product.heroLede}</p>
      <DownloadActions layout="hero" showGhostLink />
      <p class="hero-trust-line" aria-label="Trust highlights">
        {heroTrustLine.join(' · ')}
      </p>
    </div>

    <div class="hero-device-stack" aria-label="Clarity mobile app preview">
      <div class="device-card device-card--primary">
        <img
          src="/images/app/dashboard-cash-flow.webp"
          alt="Clarity dashboard showing balances, cash flow, and spending by category."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section value-section" id="why-clarity" aria-labelledby="value-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">Why Clarity</p>
      <h2 id="value-heading">{subscriptionValue.subhead}</h2>
    </div>
    <div class="value-columns">
      {
        subscriptionValue.columns.map((column) => (
          <article class="value-column">
            <h3>{column.title}</h3>
            <p>{column.body}</p>
          </article>
        ))
      }
    </div>
    <p class="value-section__note">{subscriptionValue.pricingNote}</p>
  </section>

  <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">How it works</p>
      <h2 id="how-heading">Up and running in minutes.</h2>
      <p>Create your account, connect what you want, and use Clarity on web and mobile with the same login.</p>
    </div>
    <ol class="how-steps">
      {
        howItWorksSteps.map((step, index) => (
          <li class="how-step">
            <span class="how-step__number">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="section-cta">
      <a class="button button--primary" href={authLinks.createAccount.href}>
        {authLinks.createAccount.label}
      </a>
    </div>
  </section>

  <section class="section product-section" id="app-gallery" aria-labelledby="product-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">The app</p>
      <h2 id="product-heading">Built for daily review.</h2>
      <p>
        Real screens from Clarity. Mobile apps are the fullest day-to-day experience; the web
        companion covers the core flow with the same account.
      </p>
    </div>
    <div class="product-grid">
      {
        productScreens.map((screen) => (
          <article class="product-card">
            <figure>
              <img
                src={screen.image}
                alt={screen.alt}
                width="720"
                height="1415"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div>
              <span>{screen.label}</span>
              <h3>{screen.title}</h3>
              <p>{screen.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-heading">
    <div class="section__header">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-heading">Common questions</h2>
      <p>
        Clear answers about accounts, Plaid, Rex, and your data. For security details, see our{' '}
        <a href="/security">Security</a> page.
      </p>
    </div>
    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section final-cta" aria-labelledby="final-cta-heading">
    <div class="final-cta__inner">
      <h2 id="final-cta-heading">Ready to see your money clearly?</h2>
      <p class="final-cta__lede">
        Create your account and start on web — same login on iPhone and Android when you download.
      </p>
      <DownloadActions layout="footer" showStoreBadges />
      <p class="final-cta__note">
        Already have an account? <a href={authLinks.signIn.href}>Log in</a>
      </p>
    </div>
  </section>
</BaseLayout>
