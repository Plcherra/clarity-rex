---
import BaseLayout from '@layouts/BaseLayout.astro';
import PublicForm from '../components/PublicForm.astro';
import { faqs, primaryCta, publicRoutes } from '@content/site';

const page = publicRoutes.find((route) => route.path === '/')!;

const heroTrustSignals = [
  'User-authorized connections',
  'No bank credentials collected',
  'Private context for Rex only',
] as const;

const trustSignalCards = [
  {
    icon: '✓',
    title: 'User-controlled connections',
    body: 'Clarity is designed around explicit account authorization through Plaid.',
  },
  {
    icon: '⌁',
    title: 'Privacy-first by default',
    body: 'Public forms never ask for bank credentials, account numbers, or documents.',
  },
  {
    icon: '↗',
    title: 'Your data stays yours',
    body: 'Disconnect and deletion paths are documented before production access.',
  },
  {
    icon: '◆',
    title: 'Built for review',
    body: 'Security, consent, and AI assistant boundaries are stated in plain language.',
  },
] as const;

const heroMetrics = [
  ['Income', '$2,715.10'],
  ['Spending', '$1,582.61'],
  ['Net flow', '$1,132.49'],
] as const;

const problemCards = [
  {
    title: 'Money apps show numbers, not meaning.',
    body: 'Transactions, budgets, goals, and context usually live apart, so the real story gets buried.',
  },
  {
    title: 'Memory and money should not be separate apps.',
    body: 'Rex works best when spending, goals, and what Clarity knows stay in one calm workspace.',
  },
  {
    title: 'AI needs approved context.',
    body: 'Rex can be more useful when it sees the financial context, memory, and goals you choose to provide.',
  },
] as const;

const featureCards = [
  {
    label: 'Dashboard',
    title: 'See the month at a glance.',
    body: 'Balances, cash flow, spending by category, and trends — all in a polished dark UI built for daily use.',
    image: '/images/app/dashboard-cash-flow.webp',
    alt: 'Clarity dashboard with total balance, monthly cash flow chart, and spending by category.',
  },
  {
    label: 'Rex chat',
    title: 'Ask in chat when you need context.',
    body: 'Rex is the AI assistant inside Clarity. Talk naturally about money, goals, and life without leaving the app.',
    image: '/images/app/rex-chat.webp',
    alt: 'Clarity Rex assistant chat screen with starter prompts and message composer.',
  },
  {
    label: 'Knows',
    title: 'What Clarity remembers — clearly labeled.',
    body: 'People, facts, events, and preferences stay organized. Saved memory is separate from searchable chat history.',
    image: '/images/app/knows.webp',
    alt: 'Clarity Knows screen showing people, facts, and events Clarity remembers.',
  },
  {
    label: 'Budgets',
    title: 'Budget from real categories and real behavior.',
    body: 'Set category targets, watch what is left, and compare budget pressure against actual spending.',
    image: '/images/app/budgets.webp',
    alt: 'Clarity budgets screen showing monthly category targets and spending totals.',
  },
  {
    label: 'Transactions',
    title: 'Know what changed before it surprises you.',
    body: 'Filter by month, category, account, and history. Keep transaction organization understandable.',
    image: '/images/app/transactions.webp',
    alt: 'Clarity transactions screen with month, category, account, and history filters.',
  },
  {
    label: 'Voice',
    title: 'Talk to Rex hands-free.',
    body: 'Voice sessions use the same Rex Brain as chat — same memory rules, same financial truth, same privacy boundaries.',
    image: '/images/app/voice.webp',
    alt: 'Clarity voice usage screen showing Rex voice activity and daily call charts.',
  },
] as const;

const webappHighlights = [
  {
    title: 'Desktop-friendly layout',
    body: 'The webapp adapts Clarity’s dark UI for wider screens — dashboards, chat, and Knows stay scannable.',
  },
  {
    title: 'Installable PWA',
    body: 'Add Clarity to your home screen or dock. One tap back to your money picture and Rex.',
  },
  {
    title: 'Same Rex Brain',
    body: 'Chat, voice, memory, and financial context follow the same rules on mobile and web.',
  },
] as const;

const consentSteps = [
  'You choose when to connect a financial account.',
  'Plaid handles the secure authorization flow.',
  'Clarity uses permitted account data to organize product context.',
  'You can disconnect accounts or request deletion through public support paths.',
] as const;

const showcaseScreens = [
  {
    title: 'Cash flow overview',
    body: 'Income, spending, net flow, and monthly trends with enough context to understand the month.',
    image: '/images/app/dashboard-cash-flow.webp',
    alt: 'Clarity dashboard showing total balance, cash flow chart, and spending categories.',
    featured: true,
  },
  {
    title: 'Rex assistant',
    body: 'Chat, Knows, goals, and conversation history in one assistant workspace.',
    image: '/images/app/rex-chat.webp',
    alt: 'Clarity Rex assistant chat with starter prompts.',
    featured: false,
  },
  {
    title: 'What Clarity knows',
    body: 'People, facts, events, and preferences — organized and editable.',
    image: '/images/app/knows.webp',
    alt: 'Clarity Knows screen with people, facts, and events.',
    featured: false,
  },
  {
    title: 'Accounts',
    body: 'Connected account summaries keep the headline number focused on monthly net flow.',
    image: '/images/app/accounts.webp',
    alt: 'Clarity accounts screen showing connected accounts and balances.',
    featured: false,
  },
  {
    title: 'Budgets',
    body: 'Category targets, remaining budget, and spending pressure in one view.',
    image: '/images/app/budgets.webp',
    alt: 'Clarity budgets screen with category targets.',
    featured: false,
  },
  {
    title: 'Transactions',
    body: 'Searchable history with filters for month, category, account, and role.',
    image: '/images/app/transactions.webp',
    alt: 'Clarity transactions screen with filters and history.',
    featured: false,
  },
  {
    title: 'Goals',
    body: 'Track commitments and progress alongside your financial picture.',
    image: '/images/app/goals.webp',
    alt: 'Clarity goals screen showing active goals and progress.',
    featured: false,
  },
  {
    title: 'Voice with Rex',
    body: 'Hands-free conversations with the same assistant brain as chat.',
    image: '/images/app/voice.webp',
    alt: 'Clarity voice usage screen with Rex activity charts.',
    featured: false,
  },
] as const;

const faqItems = faqs.slice(0, 7);
---

<BaseLayout title={page.title} description={page.description}>
  <section class="landing-hero">
    <div class="landing-hero__copy">
      <div class="hero-brand-lockup" aria-hidden="true">
        <img
          class="hero-brand-lockup__mark"
          src="/clarity-mark-192.png"
          alt=""
          width="72"
          height="72"
          decoding="async"
        />
        <div class="hero-brand-lockup__text">
          <p class="eyebrow">Clarity beta · Mobile today · Web next</p>
        </div>
      </div>
      <h1>One calm place for money, memory, and Rex.</h1>
      <p class="landing-hero__lede">
        Clarity combines user-authorized accounts, budgets, goals, and durable memory with Rex —
        the AI assistant that explains your financial picture without moving money or guessing.
      </p>
      <div class="webapp-banner" role="note">
        <span class="webapp-banner__badge">Coming soon</span>
        <div>
          <strong>Now building the webapp version</strong>
          <p>Works great on desktop too — installable as a PWA with the same dark UI and Rex Brain.</p>
        </div>
      </div>
      <div class="hero-trust-row" aria-label="Clarity trust highlights">
        {heroTrustSignals.map((signal) => <span>{signal}</span>)}
      </div>
      <div class="landing-hero__actions">
        <a class="button button--large" href={primaryCta.href}>Request early access</a>
        <a class="button button--secondary button--large" href="#product-gallery">
          See the app
        </a>
      </div>
      <div class="landing-hero__metrics" aria-label="Sample monthly snapshot">
        {heroMetrics.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-device-stack hero-device-stack--premium" aria-label="Clarity mobile app screenshots">
      <div class="device-card device-card--secondary device-card--left">
        <img
          src="/images/app/rex-chat.webp"
          alt="Clarity Rex assistant chat screen."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="device-card device-card--primary">
        <img
          src="/images/app/dashboard-cash-flow.webp"
          alt="Clarity mobile dashboard showing balances, cash flow, and spending by category."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="device-card device-card--secondary device-card--right">
        <img
          src="/images/app/knows.webp"
          alt="Clarity Knows screen showing saved people, facts, and events."
          width="720"
          height="1415"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hero-proof-card hero-proof-card--top">
        <span>Dark UI</span>
        <strong>Built for daily review — mobile and web</strong>
      </div>
      <div class="hero-proof-card hero-proof-card--bottom">
        <span>Rex context</span>
        <strong>Answers from approved account and memory context</strong>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Trust signals">
    {trustSignalCards.map((signal) => (
      <div class="trust-strip__item">
        <span aria-hidden="true">{signal.icon}</span>
        <div>
          <strong>{signal.title}</strong>
          <p>{signal.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="section section--split problem-section" aria-labelledby="problem-heading">
    <div class="section__header">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-heading">Financial confidence breaks when the story is scattered.</h2>
      <p>
        Clarity is built for the space between raw transactions and real decisions: what changed,
        why it matters, and what deserves attention next.
      </p>
    </div>
    <div class="problem-list problem-list--premium">
      {problemCards.map((problem, index) => (
        <article class="problem-card problem-card--premium">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{problem.title}</h3>
            <p>{problem.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section webapp-section" id="webapp" aria-labelledby="webapp-heading">
    <div class="webapp-section__copy">
      <p class="eyebrow">Webapp · PWA</p>
      <h2 id="webapp-heading">Clarity on desktop — same product, wider canvas.</h2>
      <p>
        We are building a webapp version of Clarity that works great on desktop and laptop screens.
        Install it as a PWA, pick up where you left off, and use Rex with the same privacy-first
        boundaries as mobile.
      </p>
      <ul class="webapp-section__list">
        <li>Responsive layouts for dashboard, chat, Knows, budgets, and transactions</li>
        <li>Installable progressive web app — no app store required on desktop</li>
        <li>Same user-authorized Plaid connections and data controls</li>
      </ul>
      <div class="landing-hero__actions">
        <a class="button" href={primaryCta.href}>Join the beta waitlist</a>
        <a class="button button--secondary" href="#data-consent">Privacy &amp; consent</a>
      </div>
    </div>
    <div class="webapp-section__cards">
      {webappHighlights.map((item) => (
        <article class="webapp-section__card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="features-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">What Clarity does</p>
      <h2 id="features-heading">Finance, memory, and Rex — one polished workspace.</h2>
      <p>
        Current mobile screens shown below with sample data. Clarity combines transaction
        organization, budgets, memory, goals, voice, and assistant conversations without claiming
        to replace professional financial advice.
      </p>
    </div>
    <div class="feature-showcase feature-showcase--six">
      {featureCards.map((feature) => (
        <article class="feature-showcase__card">
          <figure>
            <img
              src={feature.image}
              alt={feature.alt}
              width="720"
              height="1415"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <span>{feature.label}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section data-consent" id="data-consent" aria-labelledby="consent-heading">
    <div class="data-consent__copy">
      <p class="eyebrow">Plaid and consent</p>
      <h2 id="consent-heading">Account connections should be explicit, understandable, and reversible.</h2>
      <p>
        Clarity is designed around user-authorized financial account connections through providers
        such as Plaid. The public site never asks for bank credentials. Rex uses only the context
        available inside Clarity and does not move money, initiate payments, or make financial
        decisions for you.
      </p>
      <div class="consent-safety-grid" aria-label="Data handling principles">
        <div>
          <span>Consent</span>
          <strong>You choose what to connect.</strong>
        </div>
        <div>
          <span>Control</span>
          <strong>Disconnect and deletion paths are public.</strong>
        </div>
        <div>
          <span>Boundaries</span>
          <strong>Rex explains context, not guarantees.</strong>
        </div>
      </div>
      <div class="landing-hero__actions">
        <a class="button button--secondary" href="/privacy">Read Privacy</a>
        <a class="button button--secondary" href="/security">Read Security</a>
        <a class="button button--secondary" href="/data-deletion">Data deletion</a>
      </div>
    </div>
    <div class="consent-steps">
      {consentSteps.map((step, index) => (
        <article>
          <span>{index + 1}</span>
          <p>{step}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section product-showcase" id="product-gallery" aria-labelledby="showcase-heading">
    <div class="section__header section__header--center">
      <p class="eyebrow">Product gallery</p>
      <h2 id="showcase-heading">The current Clarity experience — dark, calm, scannable.</h2>
      <p>
        Screens from the latest mobile build, selected to show dashboard, Rex, Knows, budgets,
        transactions, goals, and voice. Sample or redacted financial data for review.
      </p>
    </div>
    <div class="screen-gallery screen-gallery--expanded">
      {showcaseScreens.map((screen) => (
        <article
          class:list={[
            'screen-gallery__item',
            screen.featured && 'screen-gallery__item--featured',
          ]}
        >
          <figure>
            <img
              src={screen.image}
              alt={screen.alt}
              width="720"
              height="1415"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <h3>{screen.title}</h3>
            <p>{screen.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--split faq-section" aria-labelledby="faq-heading">
    <div class="section__header">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-heading">Clear answers for reviewers and early users.</h2>
      <p>
        Clarity is early, but the data boundaries are intentional: explicit consent, visible
        controls, and no public collection of sensitive financial details.
      </p>
    </div>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section final-cta final-cta--premium" id="request-access" aria-labelledby="request-access-heading">
    <div class="section__header">
      <p class="eyebrow">Early access</p>
      <h2 id="request-access-heading">Request early access to Clarity.</h2>
      <p>
        Join the beta list for mobile today and webapp updates as the desktop PWA ships. Keep it
        high level and do not submit bank credentials, account numbers, or sensitive financial details.
      </p>
    </div>
    <PublicForm variant="waitlist" />
  </section>
</BaseLayout>
