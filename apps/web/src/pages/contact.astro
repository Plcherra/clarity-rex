---
import BaseLayout from '@layouts/BaseLayout.astro';
import PublicForm from '../components/PublicForm.astro';
import { product, publicRoutes } from '@content/site';

const page = publicRoutes.find((route) => route.path === '/contact')!;
---

<BaseLayout title={page.title} description={page.description}>
  <section class="page-shell">
  <h1>Contact Clarity</h1>
  <p>
    Use this public contact path for product questions, beta access, privacy requests, data
    deletion, or security concerns. You can also email <a href={`mailto:${product.supportEmail}`}>
    {product.supportEmail}</a>.
  </p>
  <p>
    For more context before contacting us, review
    <a href="/privacy">Privacy</a>, <a href="/terms">Terms</a>,
    <a href="/security">Security</a>, or <a href="/data-deletion">Data Deletion</a>.
  </p>
  <PublicForm variant="contact" />
  </section>
</BaseLayout>
