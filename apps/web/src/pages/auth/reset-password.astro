---
import AuthLayout from '@layouts/AuthLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<AuthLayout
  title="Reset password - Clarity"
  description="Choose a new password for your Clarity account."
>
  <section class="auth-card" aria-labelledby="reset-password-title">
    <p class="eyebrow">Account security</p>
    <h1 id="reset-password-title">Choose a new password</h1>
    <p class="auth-card__lede">
      After you reset here, return to Clarity on web or in the app and sign in with your new password.
    </p>

    <div id="reset-password-loading" class="auth-alert">
      <strong>Opening your secure reset link...</strong>
      <p>One moment while we verify this link.</p>
    </div>

    <div id="reset-password-error" class="auth-alert auth-alert--error" hidden>
      <strong>We could not open this reset link.</strong>
      <p id="reset-password-error-text">
        The link may have expired or already been used. Request a new reset email from the app.
      </p>
    </div>

    <div id="reset-password-form-error" class="auth-alert auth-alert--error" hidden>
      <p id="reset-password-form-error-text"></p>
    </div>

    <form id="reset-password-form" class="auth-form" hidden>
      <label class="auth-field">
        <span>New password</span>
        <input id="reset-password-input" type="password" minlength="8" required autocomplete="new-password" />
      </label>
      <label class="auth-field">
        <span>Confirm password</span>
        <input id="reset-password-confirm" type="password" minlength="8" required autocomplete="new-password" />
      </label>
      <button class="button button--large" type="submit" id="reset-password-submit">
        Update password
      </button>
    </form>

    <div id="reset-password-success" class="auth-alert auth-alert--success" hidden>
      <strong>Password updated.</strong>
      <p>You can close this page and sign in on web or in the Clarity app.</p>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    (function () {
      var loading = document.getElementById('reset-password-loading');
      var errorPanel = document.getElementById('reset-password-error');
      var errorText = document.getElementById('reset-password-error-text');
      var formErrorPanel = document.getElementById('reset-password-form-error');
      var formErrorText = document.getElementById('reset-password-form-error-text');
      var form = document.getElementById('reset-password-form');
      var success = document.getElementById('reset-password-success');
      var submitButton = document.getElementById('reset-password-submit');
      var recoveryReady = false;

      function showFatalError(message) {
        if (loading) loading.hidden = true;
        if (form) form.hidden = true;
        if (success) success.hidden = true;
        if (formErrorPanel) formErrorPanel.hidden = true;
        if (errorPanel) errorPanel.hidden = false;
        if (errorText && message) errorText.textContent = message;
      }

      function showFormError(message) {
        if (formErrorPanel) formErrorPanel.hidden = false;
        if (formErrorText) formErrorText.textContent = message || '';
      }

      function clearFormError() {
        if (formErrorPanel) formErrorPanel.hidden = true;
        if (formErrorText) formErrorText.textContent = '';
      }

      function showResetForm() {
        recoveryReady = true;
        if (loading) loading.hidden = true;
        if (errorPanel) errorPanel.hidden = true;
        if (success) success.hidden = true;
        if (form) form.hidden = false;
      }

      function readUrlAuthError() {
        var params = new URLSearchParams(window.location.search);
        var hash = window.location.hash.startsWith('#')
          ? window.location.hash.slice(1)
          : window.location.hash;
        var hashParams = new URLSearchParams(hash);
        var authError =
          params.get('error_description') ||
          hashParams.get('error_description') ||
          params.get('error') ||
          hashParams.get('error');
        if (!authError) return null;
        return decodeURIComponent(String(authError).replace(/\+/g, ' '));
      }

      function readHashTokens() {
        var hash = window.location.hash.startsWith('#')
          ? window.location.hash.slice(1)
          : window.location.hash;
        if (!hash) return null;
        var hashParams = new URLSearchParams(hash);
        var accessToken = hashParams.get('access_token');
        var refreshToken = hashParams.get('refresh_token');
        if (!accessToken || !refreshToken) return null;
        return {
          accessToken: accessToken,
          refreshToken: refreshToken,
          type: hashParams.get('type'),
        };
      }

      if (!supabaseUrl || !supabaseAnonKey || !window.supabase) {
        showFatalError('Password reset is not configured on this site yet.');
        return;
      }

      var urlError = readUrlAuthError();
      if (urlError) {
        showFatalError(urlError);
        return;
      }

      var client = window.supabase.createClient(supabaseUrl, supabaseAnonKey, {
        auth: {
          detectSessionInUrl: true,
          flowType: 'pkce',
          persistSession: true,
          autoRefreshToken: false,
        },
      });

      client.auth.onAuthStateChange(function (event, session) {
        if (!session) return;
        if (
          event === 'PASSWORD_RECOVERY' ||
          event === 'SIGNED_IN' ||
          event === 'INITIAL_SESSION' ||
          event === 'TOKEN_REFRESHED' ||
          event === 'USER_UPDATED'
        ) {
          showResetForm();
        }
      });

      function establishRecoverySession() {
        var params = new URLSearchParams(window.location.search);
        var code = params.get('code');
        if (code) {
          return client.auth.exchangeCodeForSession(code).then(function (result) {
            if (result.error) {
              throw result.error;
            }
            return result.data.session;
          });
        }

        var tokens = readHashTokens();
        if (tokens) {
          return client.auth
            .setSession({
              access_token: tokens.accessToken,
              refresh_token: tokens.refreshToken,
            })
            .then(function (result) {
              if (result.error) {
                throw result.error;
              }
              return result.data.session;
            });
        }

        return client.auth.getSession().then(function (result) {
          return result.data.session;
        });
      }

      establishRecoverySession()
        .then(function (session) {
          if (session) {
            showResetForm();
            return;
          }
          // detectSessionInUrl may still be resolving; give it a short window.
          return new Promise(function (resolve) {
            window.setTimeout(resolve, 800);
          }).then(function () {
            return client.auth.getSession();
          }).then(function (result) {
            if (result.data.session) {
              showResetForm();
              return;
            }
            showFatalError(
              'This reset link is invalid or expired. Request a new password reset email from the Clarity app.',
            );
          });
        })
        .catch(function (error) {
          var message =
            error && error.message
              ? error.message
              : 'This reset link is invalid or expired. Request a new password reset email from the Clarity app.';
          showFatalError(message);
        });

      if (form) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          clearFormError();

          if (!recoveryReady) {
            showFormError('Wait until the reset link finishes verifying.');
            return;
          }

          var passwordInput = document.getElementById('reset-password-input');
          var confirmInput = document.getElementById('reset-password-confirm');
          var password = passwordInput && 'value' in passwordInput ? passwordInput.value : '';
          var confirm = confirmInput && 'value' in confirmInput ? confirmInput.value : '';

          if (password.length < 8) {
            showFormError('Use at least 8 characters for your new password.');
            return;
          }
          if (password !== confirm) {
            showFormError('Passwords do not match.');
            return;
          }

          if (submitButton) submitButton.disabled = true;

          client.auth.updateUser({ password: password }).then(function (result) {
            if (submitButton) submitButton.disabled = false;
            if (result.error) {
              showFormError(result.error.message);
              return;
            }
            if (form) form.hidden = true;
            if (errorPanel) errorPanel.hidden = true;
            clearFormError();
            if (success) success.hidden = false;
          });
        });
      }
    })();
  </script>
</AuthLayout>

<style>
  .auth-form {
    display: grid;
    gap: 14px;
    margin-top: 18px;
    text-align: left;
  }

  .auth-field {
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  .auth-field input {
    border: 1px solid var(--color-border-strong);
    border-radius: 10px;
    background: var(--color-canvas);
    color: var(--color-ink);
    padding: 12px 14px;
    font: inherit;
  }

  .auth-field input:focus {
    outline: 2px solid rgba(15, 125, 104, 0.45);
    outline-offset: 1px;
  }

  .auth-alert--success {
    background: rgba(15, 125, 104, 0.14);
    border: 1px solid rgba(15, 125, 104, 0.35);
    color: var(--color-ink);
  }
</style>
