---
import AuthLayout from '@layouts/AuthLayout.astro';
import { product } from '@content/site';

/** Flutter web PWA — desktop / no-app fallback. */
const webAppUrl = 'https://goclarity.app/app/';
/** Custom scheme — used when this page loads in a browser instead of via App Link. */
const nativeAppUrl = 'io.goclarity.clarity://login-callback';
const steps = [
  {
    title: 'Continue in Clarity',
    body: 'If Clarity did not open automatically, use Open Clarity below.',
  },
  {
    title: 'Log in if needed',
    body: 'Use the same email and password you used to create your account.',
  },
  {
    title: 'Finish setup inside Clarity',
    body: 'Connect accounts, explore your dashboard, and talk with Rex when you are ready.',
  },
] as const;
---

<AuthLayout
  title="Email confirmed - Clarity"
  description="Your Clarity account email address is confirmed. Continue in the Clarity app."
>
  <section class="auth-card" aria-labelledby="auth-confirmed-title">
    <div class="auth-card__badge" aria-hidden="true">
      <span class="auth-card__check">✓</span>
    </div>
    <p class="eyebrow">Account verified</p>
    <h1 id="auth-confirmed-title">You are all set.</h1>
    <p class="auth-card__lede" id="auth-confirmed-lede">
      Your email is confirmed. Opening Clarity…
    </p>

    <div id="auth-confirmed-error" class="auth-alert auth-alert--error" hidden>
      <strong>We could not confirm this link.</strong>
      <p id="auth-confirmed-error-text">
        The link may have expired or already been used. Request a new confirmation email from the app, or contact support.
      </p>
    </div>

    <ol class="auth-steps" id="auth-confirmed-steps" hidden>
      {
        steps.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <span>{step.body}</span>
          </li>
        ))
      }
    </ol>

    <div class="auth-card__actions" id="auth-confirmed-actions" hidden>
      <a class="button button--large" id="auth-confirmed-open-app" href={nativeAppUrl}>
        Open Clarity
      </a>
      <a class="button button--secondary button--large" href={webAppUrl}>
        Continue on web
      </a>
      <a class="button button--secondary button--large" href={`mailto:${product.supportEmail}`}>
        Contact support
      </a>
    </div>
  </section>

  <script is:inline define:vars={{ webAppUrl, nativeAppUrl }}>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var hash = window.location.hash.startsWith('#')
        ? window.location.hash.slice(1)
        : window.location.hash;
      var hashParams = new URLSearchParams(hash);
      var error = params.get('error') || hashParams.get('error');
      var errorDescription =
        params.get('error_description') || hashParams.get('error_description');

      var panel = document.getElementById('auth-confirmed-error');
      var text = document.getElementById('auth-confirmed-error-text');
      var steps = document.getElementById('auth-confirmed-steps');
      var actions = document.getElementById('auth-confirmed-actions');
      var lede = document.getElementById('auth-confirmed-lede');
      var openApp = document.getElementById('auth-confirmed-open-app');
      var suffix = window.location.search + window.location.hash;
      var nativeTarget =
        String(nativeAppUrl || 'io.goclarity.clarity://login-callback') + suffix;
      var webTarget =
        String(webAppUrl || 'https://goclarity.app/app/').replace(/\/?$/, '/') +
        suffix;

      function showManualContinue(message) {
        if (lede) {
          lede.textContent =
            message ||
            'Your email is confirmed. Tap Open Clarity to continue in the app.';
        }
        if (steps) steps.hidden = false;
        if (actions) actions.hidden = false;
        if (openApp) openApp.setAttribute('href', nativeTarget);
      }

      if (error) {
        if (panel) panel.hidden = false;
        if (text && errorDescription) {
          text.textContent = decodeURIComponent(
            String(errorDescription).replace(/\+/g, ' '),
          );
        }
        showManualContinue(
          'We could not confirm this link automatically. Request a new confirmation email from the app, or contact support.',
        );
        return;
      }

      if (openApp) openApp.setAttribute('href', nativeTarget);

      // Always try the native scheme first so Chrome/Safari hand off into Clarity.
      try {
        window.location.replace(nativeTarget);
      } catch (_) {
        showManualContinue();
        return;
      }

      window.setTimeout(function () {
        showManualContinue();
      }, 1200);
    })();
  </script>
</AuthLayout>
