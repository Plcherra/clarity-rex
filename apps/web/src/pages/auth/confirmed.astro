---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Email confirmed - Clarity"
  description="Your Clarity account email address is confirmed. Return to the app and sign in."
>
  <section class="page-shell">
    <p class="eyebrow">Account verified</p>
    <h1>Your email is confirmed.</h1>
    <p>
      You can return to the Clarity app on your phone and sign in with the email
      and password you used to create your account.
    </p>
    <p>If the app is not open yet, install or reopen Clarity and choose Sign in.</p>
    <div class="hero__actions">
      <a class="button" href="/">Back to Clarity</a>
    </div>
  </section>
</BaseLayout>
