---
import { authLinks, downloadLinks } from '@content/site';

type Props = {
  layout?: 'hero' | 'footer' | 'compact';
  showGhostLink?: boolean;
  /** Store badges default on for footer only — keeps the hero to one primary CTA. */
  showStoreBadges?: boolean;
  primaryLabel?: string;
};

const {
  layout = 'hero',
  showGhostLink = false,
  showStoreBadges = layout === 'footer',
  primaryLabel = authLinks.createAccount.label,
} = Astro.props;
---

<div class:list={['download-actions', `download-actions--${layout}`]}>
  <div class="download-actions__primary">
    <a class="button button--primary" href={authLinks.createAccount.href}>
      {primaryLabel}
    </a>
    {
      showGhostLink ? (
        <a class="button button--ghost" href="#how-it-works">
          See how it works
        </a>
      ) : null
    }
  </div>
  {
    showStoreBadges ? (
      <div class="download-actions__stores" aria-label="Download Clarity for mobile">
        {
          downloadLinks.appStore ? (
            <a
              class="store-badge store-badge--apple"
              href={downloadLinks.appStore}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="store-badge__label">Download on the</span>
              <span class="store-badge__name">App Store</span>
            </a>
          ) : (
            <span
              class="store-badge store-badge--apple store-badge--pending"
              aria-disabled="true"
              title="iOS App Store listing is not live yet"
            >
              <span class="store-badge__label">iOS coming soon</span>
              <span class="store-badge__name">App Store</span>
            </span>
          )
        }
        {
          downloadLinks.playStore ? (
            <a
              class="store-badge store-badge--google"
              href={downloadLinks.playStore}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="store-badge__label">Get it on</span>
              <span class="store-badge__name">Google Play</span>
            </a>
          ) : (
            <span
              class="store-badge store-badge--google store-badge--pending"
              aria-disabled="true"
              title="Google Play listing is not live yet"
            >
              <span class="store-badge__label">Android coming soon</span>
              <span class="store-badge__name">Google Play</span>
            </span>
          )
        }
      </div>
    ) : null
  }
</div>
