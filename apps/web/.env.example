# Public site URL used by Astro for canonical URLs and form redirects.
PUBLIC_SITE_URL=https://goclarity.app

# Store and web sign-in links shown on the landing page.
# Set PUBLIC_APP_STORE_URL to your live App Store listing when published.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.clarity.clarity
PUBLIC_WEB_LOGIN_URL=https://goclarity.app/app

# Public Supabase values for the password reset web page only.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key
