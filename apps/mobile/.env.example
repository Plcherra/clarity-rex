SUPABASE_URL=
SUPABASE_ANON_KEY=
# Web builds only (Flutter PWA). Native ignores this and uses
# https://goclarity.app/auth/confirmed/ for Universal / App Links.
SUPABASE_AUTH_REDIRECT_URL=https://goclarity.app/app/
REX_BACKEND_URL=https://api.goclarity.app
# Plaid credentials live on rex-api only (PLAID_CLIENT_ID, PLAID_SECRET, PLAID_WEB_REDIRECT_URI).
REX_CLOUD_VOICE_ENABLED=false
REX_STREAMING_VOICE_ENABLED=false
# Optional crash reporting (leave empty to disable). Prefer release dart-define.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
